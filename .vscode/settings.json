{
  // LaTeX Workshop (macOS): use caminhos absolutos do MacTeX/TeX Live
  // para não depender do PATH do VS Code.
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "pdflatex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "bibtex",
      "command": "/Library/TeX/texbin/bibtex",
      "args": ["%DOCFILE%"],
      "env": {}
    },
    {
      "name": "makeindex",
      "command": "/Library/TeX/texbin/makeindex",
      "args": ["%DOCFILE%"],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdf)",
      "tools": ["latexmk"]
    },
    {
      "name": "pdflatex → bibtex → makeindex → pdflatex ×2",
      "tools": ["pdflatex", "bibtex", "makeindex", "pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (pdf)",

  // Evita loop de build a cada alteração enquanto você instala o TeX.
  // Depois de tudo ok, você pode trocar para "onFileChange" se preferir.
  "latex-workshop.latex.autoBuild.run": "onSave"
}
